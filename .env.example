# Copiați în .env și modificați după nevoie. ./sim.sh și docker compose citesc automat .env.

# Portul expus pe host (aplicația Windows se conectează aici).
SIM_PORT=13400

# 0.0.0.0 = accesibil din Windows; 127.0.0.1 = doar din WSL.
SIM_BIND_ADDRESS=0.0.0.0

# Opțiuni pentru rpi_doip_server, de ex. verificare lentă pentru demonstrație:
# SIM_EXTRA_ARGS=--verification-min-ms 3000
SIM_EXTRA_ARGS=

# 0 = sare peste testele GoogleTest la build.
RUN_TESTS=1

# Secret HMAC (exact 64 caractere hex). Gol = secretul demo din cod.
# Dacă îl setați, setați aceeași valoare și în mediul aplicației Windows.
DOIP_DEMO_SECRET_HEX=
